{
  "name": "dsh-client",
  "version": "0.1.0",
  "private": true,
  "description": "Native macOS wrapper for the DeepSeek Harness (dsh) web GUI, supervising a loopback `dsh web` host",
  "author": "fatwang2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatwang2/dsh-client.git"
  },
  "homepage": "https://github.com/fatwang2/dsh-client#readme",
  "bugs": {
    "url": "https://github.com/fatwang2/dsh-client/issues"
  },
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "stage": "node scripts/stage-runtime.mjs",
    "dev": "npm run build && electron .",
    "package": "npm run build && npm run stage && electron-builder --dir --config.mac.identity=null",
    "dist": "npm run build && npm run stage && electron-builder --mac dmg zip --config.mac.identity=null",
    "dist:signed": "node scripts/release-mac.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
