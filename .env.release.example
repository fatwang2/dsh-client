# Copy to .env.release and keep the real file out of git.

# Developer ID identity installed in the local login Keychain.
MACOS_SIGN_IDENTITY="Developer ID Application: YOUR NAME (XXXXXXXXXX)"

# App Store Connect API key used by electron-builder for notarization.
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# Optional alternatives supported by the release preflight:
# APPLE_KEYCHAIN_PROFILE="dsh-client-notary"
# APPLE_ID="you@example.com"
# APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# APPLE_TEAM_ID="XXXXXXXXXX"

# Optional local PKCS#12 signing instead of the login Keychain:
# CSC_LINK="/path/to/DeveloperID.p12"
# CSC_KEY_PASSWORD="certificate password"
